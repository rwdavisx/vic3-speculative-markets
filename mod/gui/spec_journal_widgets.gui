widget = {
	name = "spec_je_header"
	datacontext = "[GetPlayer]"
	size = { 560 120 }
	parentanchor = hcenter
	background = {
		texture = "gfx/interface/illustrations/journal/top_illu_journal_entries.dds"
		using = top_illu_properties
	}
	widget = {
		size = { 116 116 }
		parentanchor = center
		tooltip = "SPEC_CARD_RING_TT"
		background = {
			using = circle_bg_simple_dark
		}
		icon = {
			size = { 116 116 }
			parentanchor = center
			texture = "gfx/interface/backgrounds/round_frame_dec.dds"
		}
			round_progress_default = {
				size = { 96 96 }
				parentanchor = center
				visible = "[Not(Or(Country.MakeScope.Var('spec_panic').IsSet, Or(LessThan_CFixedPoint(Country.MakeScope.Var('spec_conf').GetValueWithDefault('(CFixedPoint)55'), '(CFixedPoint)20'), GreaterThanOrEqualTo_CFixedPoint(Country.MakeScope.Var('spec_conf').GetValueWithDefault('(CFixedPoint)55'), '(CFixedPoint)80'))))]"
				value = "[FixedPointToFloat(Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Country.MakeScope.Var('spec_conf').GetValueWithDefault('(CFixedPoint)55'), '(CFixedPoint)100'), '(CFixedPoint)1'), '(CFixedPoint)0'))]"
			}
			round_progress_bad = {
				size = { 96 96 }
				parentanchor = center
				visible = "[Or(Country.MakeScope.Var('spec_panic').IsSet, Or(LessThan_CFixedPoint(Country.MakeScope.Var('spec_conf').GetValueWithDefault('(CFixedPoint)55'), '(CFixedPoint)20'), GreaterThanOrEqualTo_CFixedPoint(Country.MakeScope.Var('spec_conf').GetValueWithDefault('(CFixedPoint)55'), '(CFixedPoint)80')))]"
				value = "[FixedPointToFloat(Max_CFixedPoint(Min_CFixedPoint(Divide_CFixedPoint(Country.MakeScope.Var('spec_conf').GetValueWithDefault('(CFixedPoint)55'), '(CFixedPoint)100'), '(CFixedPoint)1'), '(CFixedPoint)0'))]"
			}
			icon = {
				size = { 74 74 }
				parentanchor = center
				visible = "[Or(Country.MakeScope.Var('spec_panic').IsSet, And(Country.MakeScope.Var('spec_ld').IsSet, LessThan_CFixedPoint(Country.MakeScope.Var('spec_ld').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)3')))]"
				texture = "gfx/interface/icons/spec_markets/state_panic.dds"
			}
			icon = {
				size = { 74 74 }
				parentanchor = center
				visible = "[And(Not(Or(Country.MakeScope.Var('spec_panic').IsSet, And(Country.MakeScope.Var('spec_ld').IsSet, LessThan_CFixedPoint(Country.MakeScope.Var('spec_ld').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)3')))), Or(Country.MakeScope.Var('spec_panic_cooldown').IsSet, LessThan_CFixedPoint(Country.MakeScope.Var('spec_conf').GetValueWithDefault('(CFixedPoint)55'), '(CFixedPoint)40')))]"
				texture = "gfx/interface/icons/spec_markets/state_wary.dds"
			}
			icon = {
				size = { 74 74 }
				parentanchor = center
				visible = "[And(Not(Or(Or(Country.MakeScope.Var('spec_panic').IsSet, And(Country.MakeScope.Var('spec_ld').IsSet, LessThan_CFixedPoint(Country.MakeScope.Var('spec_ld').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)3'))), Country.MakeScope.Var('spec_panic_cooldown').IsSet)), And(GreaterThanOrEqualTo_CFixedPoint(Country.MakeScope.Var('spec_conf').GetValueWithDefault('(CFixedPoint)55'), '(CFixedPoint)40'), LessThan_CFixedPoint(Country.MakeScope.Var('spec_conf').GetValueWithDefault('(CFixedPoint)55'), '(CFixedPoint)60')))]"
				texture = "gfx/interface/icons/spec_markets/state_steady.dds"
			}
			icon = {
				size = { 74 74 }
				parentanchor = center
				visible = "[And(Not(Or(Or(Country.MakeScope.Var('spec_panic').IsSet, And(Country.MakeScope.Var('spec_ld').IsSet, LessThan_CFixedPoint(Country.MakeScope.Var('spec_ld').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)3'))), Country.MakeScope.Var('spec_panic_cooldown').IsSet)), And(GreaterThanOrEqualTo_CFixedPoint(Country.MakeScope.Var('spec_conf').GetValueWithDefault('(CFixedPoint)55'), '(CFixedPoint)60'), LessThan_CFixedPoint(Country.MakeScope.Var('spec_conf').GetValueWithDefault('(CFixedPoint)55'), '(CFixedPoint)80')))]"
				texture = "gfx/interface/icons/spec_markets/state_buoyant.dds"
			}
			icon = {
				size = { 74 74 }
				parentanchor = center
				visible = "[And(Not(Or(Or(Country.MakeScope.Var('spec_panic').IsSet, And(Country.MakeScope.Var('spec_ld').IsSet, LessThan_CFixedPoint(Country.MakeScope.Var('spec_ld').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)3'))), Country.MakeScope.Var('spec_panic_cooldown').IsSet)), GreaterThanOrEqualTo_CFixedPoint(Country.MakeScope.Var('spec_conf').GetValueWithDefault('(CFixedPoint)55'), '(CFixedPoint)80'))]"
				texture = "gfx/interface/icons/spec_markets/state_mania.dds"
			}
	}
	button = {
		using = default_button
		size = { 170 30 }
		position = { -8 -8 }
		parentanchor = bottom|right
		text = "SPEC_OPEN_TAB"
		tooltip = "SPEC_OPEN_TAB_TT"
		onclick = "[GetVariableSystem.Clear('spec_pick_slot')]"
		onclick = "[GetVariableSystem.Set('spec_finance_tab', 'booms')]"
		onclick = "[GetVariableSystem.Set('spec_finance', 'open')]"
		onclick = "[InformationPanelBar.ClosePanel]"
	}
}

