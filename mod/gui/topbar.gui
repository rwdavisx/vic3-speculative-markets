# the topbar's Market Confidence (market_tab.topbar_item): all of its button but the click
template spec_topbar_confidence {
	size = { 52 30 }
	tooltip = "[SelectLocalization(Not(GreaterThan_CFixedPoint(Country.MakeScope.ScriptValue('spec_law_mult'), '(CFixedPoint)0')), 'SPEC_TOP_OFF_TT', SelectLocalization(LessThan_CFixedPoint(Country.MakeScope.Var('spec_conf').GetValueWithDefault('(CFixedPoint)-1'), '(CFixedPoint)0'), 'SPEC_TOP_FRESH_TT', 'SPEC_TOP_TT'))]"
	tooltipwidget = {
		TooltipWidgetType = {
			blockoverride "tooltip_content_after" {
				flowcontainer = {
					direction = vertical
					visible = "[And(GreaterThan_CFixedPoint(Country.MakeScope.ScriptValue('spec_law_mult'), '(CFixedPoint)0'), Not(LessThan_CFixedPoint(Country.MakeScope.Var('spec_conf').GetValueWithDefault('(CFixedPoint)-1'), '(CFixedPoint)0')))]"
					spacing = 10
					margin_top = 10
					flowcontainer = {
						direction = vertical
						margin = { 10 0 }
						margin_bottom = 8
						background = {
							using = paper_bg
						}
						textbox = {
							parentanchor = hcenter
							autoresize = yes
							align = hcenter|nobaseline
							margin_top = 10
							margin_bottom = 10
							default_format = "#title"
							text = "SPEC_TOP_CONF_HIST"
						}
						widget = {
							size = { 441 118 }
							widget = {
								position = { 26 0 }
								size = { 359 100 }
								widget = {
									size = { 359 100 }
									icon = {
										position = { 0 20 }
										size = { 100% 1 }
										texture = "gfx/interface/graph/white.dds"
										color = { 1 1 1 0.12 }
									}
									icon = {
										position = { 0 50 }
										size = { 100% 1 }
										texture = "gfx/interface/graph/white.dds"
										color = { 1 1 1 0.35 }
									}
									icon = {
										position = { 0 80 }
										size = { 100% 1 }
										texture = "gfx/interface/graph/white.dds"
										color = { 1 1 1 0.12 }
									}
									widget = {
										position = { 0 0 }
										size = { 9 100 }
										tooltip = "SPEC_HIST_36_TT"
										progressbar = {
											position = { 0 0 }
											size = { 100% 50 }
											direction = vertical
											progresstexture = "gfx/interface/graph/white.dds"
											noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
											color = { 0.80 0.62 0.28 0.9 }
											min = 50
											max = 100
											value = "[FixedPointToFloat(Country.MakeScope.Var('spec_hist36').GetValueWithDefault('(CFixedPoint)50'))]"
										}
										progressbar = {
											position = { 0 0 }
											size = { 100% 20 }
											direction = vertical
											progresstexture = "gfx/interface/graph/white.dds"
											noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
											color = { 0.74 0.24 0.20 0.9 }
											min = 80
											max = 100
