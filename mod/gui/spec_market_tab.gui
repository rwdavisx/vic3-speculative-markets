										flowcontainer = {
											using = set_level_bar_background
											set_level_bar_item = {
												tooltip = "SPEC_STANCE_TIGHT_TT"
												blockoverride "size" {
													size = { 56 32 }
												}
												blockoverride "button_texture" {
													texture = "gfx/interface/budget/budget_set_very_low.dds"
												}
												blockoverride "click" {
													enabled = "[And(Country.IsLocalPlayer, GetScriptedGui('spec_sgui_tight').IsValid(GuiScope.SetRoot(Country.MakeScope).End))]"
													onclick = "[GetScriptedGui('spec_sgui_tight').Execute(GuiScope.SetRoot(Country.MakeScope).End)]"
													using = budget_coins_lvl_1_button_sound
												}
												blockoverride "is_selected_visibility" {
													visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('spec_stance').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)-1')]"
												}
												blockoverride "is_clickable_alpha" {
													alpha = "[TransparentIfFalse(Or(And(Country.IsLocalPlayer, GetScriptedGui('spec_sgui_tight').IsValid(GuiScope.SetRoot(Country.MakeScope).End)), EqualTo_CFixedPoint(Country.MakeScope.Var('spec_stance').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)-1')))]"
												}
