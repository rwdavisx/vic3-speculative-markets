types spec_market_types {
	type spec_il_ov1 = widget {
		position = { 46 24 }
		size = { 207 14 }
		widget = {
			position = { 0 0 }
			size = { 32 100% }
			scissor = yes
			progressbar = {
				size = { 100% 100% }
				progresstexture = "gfx/interface/progressbar/progressbar_white.dds"
				noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
				spriteType = Corneredtiled
				spriteborder = { 4 4 }
				texture_density = 2
				color = { 0.28 0.34 0.68 1 }
				using = progressbar_texture_properties
				skip_initial_animation = yes
				animate_negative_changes = yes
				state = {
					name = progress_changed
					using = Animation_Curve_Default
					duration = 1.5
				}
				min = 0
				max = 1
				block "pos" {
		value = "[FixedPointToFloat(Country.MakeScope.Var(Concatenate('spec_ui_pos_', Goods.GetKey)).GetValueWithDefault('(CFixedPoint)0'))]"
	}
				marker = {
					widget = {
						size = { 100% 100% }
						icon = {
							size = { 30 100% }
							widgetanchor = right
							alpha = 0.7
							texture = "gfx/interface/progressbar/progressbar_white_glow.dds"
							shaderfile = "gfx/FX/pdxgui_repeat_texture.shader"
							color = { 0.28 0.34 0.68 1 }
							icon = {
								size = { 3 100% }
								parentanchor = right
								texture = "gfx/interface/progressbar/progressbar_white_glow_line.dds"
								spriteType = Corneredtiled
								spriteborder = { 0 0 }
							}
						}
						icon = {
							size = { 100% 100% }
							widgetanchor = right
							block "up" {
		visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var(Concatenate('spec_ui_move_', Goods.GetKey)).GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)1')]"
	}
							texture = "gfx/interface/graph/white.dds"
							color = { 1 1 1 0.45 }
							shaderfile = "gfx/FX/pdxgui_repeat_texture.shader"
							modify_texture = {
								name = arrow_animation
								texture = "gfx/interface/progressbar/progressbar_arrow.dds"
								spriteType = Corneredtiled
								spriteborder = { 0 0 }
								texture_density = 10
								translate_uv = { 0 0 }
								blend_mode = alphamultiply
							}
							state = {
								trigger_on_create = yes
								name = arrow_animation_1
								next = arrow_animation_2
								duration = 1
								modify_texture = {
									name = arrow_animation
									translate_uv = { -1 0 }
								}
							}
							state = {
								name = arrow_animation_2
								next = arrow_animation_1
								duration = 0
								modify_texture = {
									name = arrow_animation
									translate_uv = { 0 0 }
								}
							}
						}
						icon = {
							size = { 100% 100% }
							widgetanchor = right
							block "down" {
		visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var(Concatenate('spec_ui_move_', Goods.GetKey)).GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)-1')]"
	}
							texture = "gfx/interface/graph/white.dds"
							color = { 1 1 1 0.45 }
							shaderfile = "gfx/FX/pdxgui_repeat_texture.shader"
							modify_texture = {
								name = arrow_animation
								texture = "gfx/interface/progressbar/progressbar_arrow.dds"
