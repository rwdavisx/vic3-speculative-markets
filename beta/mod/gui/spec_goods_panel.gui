						### recovering good reads as muted
						widget = {
							size = { 100% 100% }
							alpha = "[Select_float(EqualTo_CFixedPoint(Country.MakeScope.Var(Concatenate('spec_ui_state_', Goods.GetKey)).GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)3'), '(float)0.5', '(float)1.0')]"
							widget = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var(Concatenate('spec_word_', Goods.GetKey)).GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)1')]"
								widget = {
									position = { 66 34 }
									size = { 195 22 }
									widget = {
										position = { 0 0 }
										size = { 30 100% }
										scissor = yes
										progressbar = {
											size = { 100% 100% }
											progresstexture = "gfx/interface/progressbar/progressbar_white.dds"
											noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
											spriteType = Corneredtiled
											spriteborder = { 4 4 }
											texture_density = 2
											color = { 0.28 0.34 0.68 1 }
											using = progressbar_texture_properties
											skip_initial_animation = yes
											animate_negative_changes = yes
											state = {
												name = progress_changed
												using = Animation_Curve_Default
												duration = 6
											}
											min = 0
											max = 1
											value = "[FixedPointToFloat(Country.MakeScope.Var(Concatenate('spec_ui_shown_', Goods.GetKey)).GetValueWithDefault(Country.MakeScope.Var(Concatenate('spec_ui_pos_', Goods.GetKey)).GetValueWithDefault('(CFixedPoint)0')))]"
											marker = {
												widget = {
													size = { 100% 100% }
													icon = {
														size = { 30 100% }
														widgetanchor = right
														alpha = 0.7
														texture = "gfx/interface/progressbar/progressbar_white_glow.dds"
														shaderfile = "gfx/FX/pdxgui_repeat_texture.shader"
														color = { 0.28 0.34 0.68 1 }
														icon = {
