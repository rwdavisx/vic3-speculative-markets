					}
				}
				textbox = {
					size = { 80 22 }
					text = "SPEC_GP_RISK_TEXT"
					align = center|nobaseline
					using = elide_fontsize_min
				}
				expand = {}
			}
			widget = {
				visible = "[ObjectsEqual(GetPlayer.GetCapital.GetMarket, Goods.GetMarket)]"
				size = { 8 5 }
			}
			vertical_divider_full = {
				visible = "[ObjectsEqual(GetPlayer.GetCapital.GetMarket, Goods.GetMarket)]"
				blockoverride "size" {
					size = { 0 100 }
				}
			}
			widget = {
				visible = "[ObjectsEqual(GetPlayer.GetCapital.GetMarket, Goods.GetMarket)]"
				size = { 8 5 }
			}
			vbox = {
				visible = "[ObjectsEqual(GetPlayer.GetCapital.GetMarket, Goods.GetMarket)]"
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				spacing = 8
				textbox = {
					text = "SPEC_GP_LEVERS"
					autoresize = yes
					align = center|nobaseline
				}
				flowcontainer = {
					using = set_level_bar_background
					ignoreinvisible = yes
					set_level_bar_item = {
						tooltip = "SPEC_LEVER_RESTRAIN_TT"
						blockoverride "button_texture" {
							texture = "gfx/interface/icons/spec_markets/lever_restrain.dds"
						}
						blockoverride "click" {
							enabled = "[And(GreaterThan_CFixedPoint(Country.MakeScope.Var(Concatenate('spec_ui_r_', Goods.GetKey)).GetValueWithDefault('(CFixedPoint)0'), Select_CFixedPoint(Country.IsLocalPlayer, '(CFixedPoint)0', '(CFixedPoint)1')), Not(And(Country.MakeScope.Var(Concatenate('spec_lever_wait_', Goods.GetKey)).IsSet, Not(Country.MakeScope.Var(Concatenate('spec_lever_grace_', Goods.GetKey)).IsSet))))]"
							onclick = "[GetScriptedGui('spec_sgui_restrain').Execute(GuiScope.SetRoot(Country.MakeScope).AddScope('spec_good', Goods.MakeScope).End)]"
							using = decrease_button_sound
						}
						blockoverride "is_selected_visibility" {
							visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var(Concatenate('spec_ui_r_', Goods.GetKey)).GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)2')]"
						}
						# vanilla draws the selected icon as a button on top with no click, which would swallow the click that lifts it
						blockoverride "selected_texture_size" {
							size = { 28 28 }
							onclick = "[GetScriptedGui('spec_sgui_restrain').Execute(GuiScope.SetRoot(Country.MakeScope).AddScope('spec_good', Goods.MakeScope).End)]"
							using = decrease_button_sound
						}
						blockoverride "is_clickable_alpha" {
							alpha = "[TransparentIfFalse(And(GreaterThan_CFixedPoint(Country.MakeScope.Var(Concatenate('spec_ui_r_', Goods.GetKey)).GetValueWithDefault('(CFixedPoint)0'), Select_CFixedPoint(Country.IsLocalPlayer, '(CFixedPoint)0', '(CFixedPoint)1')), Not(And(Country.MakeScope.Var(Concatenate('spec_lever_wait_', Goods.GetKey)).IsSet, Not(Country.MakeScope.Var(Concatenate('spec_lever_grace_', Goods.GetKey)).IsSet)))))]"
						}
					}
					set_level_bar_item = {
						tooltip = "SPEC_LEVER_ENCOURAGE_TT"
						blockoverride "button_texture" {
							texture = "gfx/interface/icons/spec_markets/lever_encourage.dds"
						}
						blockoverride "click" {
							enabled = "[And(GreaterThan_CFixedPoint(Country.MakeScope.Var(Concatenate('spec_ui_e_', Goods.GetKey)).GetValueWithDefault('(CFixedPoint)0'), Select_CFixedPoint(Country.IsLocalPlayer, '(CFixedPoint)0', '(CFixedPoint)1')), Not(And(Country.MakeScope.Var(Concatenate('spec_lever_wait_', Goods.GetKey)).IsSet, Not(Country.MakeScope.Var(Concatenate('spec_lever_grace_', Goods.GetKey)).IsSet))))]"
							onclick = "[GetScriptedGui('spec_sgui_encourage').Execute(GuiScope.SetRoot(Country.MakeScope).AddScope('spec_good', Goods.MakeScope).End)]"
							using = increase_button_sound
						}
						blockoverride "is_selected_visibility" {
							visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var(Concatenate('spec_ui_e_', Goods.GetKey)).GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)2')]"
						}
						# vanilla draws the selected icon as a button on top with no click, which would swallow the click that lifts it
						blockoverride "selected_texture_size" {
							size = { 28 28 }
							onclick = "[GetScriptedGui('spec_sgui_encourage').Execute(GuiScope.SetRoot(Country.MakeScope).AddScope('spec_good', Goods.MakeScope).End)]"
							using = increase_button_sound
						}
						blockoverride "is_clickable_alpha" {
							alpha = "[TransparentIfFalse(And(GreaterThan_CFixedPoint(Country.MakeScope.Var(Concatenate('spec_ui_e_', Goods.GetKey)).GetValueWithDefault('(CFixedPoint)0'), Select_CFixedPoint(Country.IsLocalPlayer, '(CFixedPoint)0', '(CFixedPoint)1')), Not(And(Country.MakeScope.Var(Concatenate('spec_lever_wait_', Goods.GetKey)).IsSet, Not(Country.MakeScope.Var(Concatenate('spec_lever_grace_', Goods.GetKey)).IsSet)))))]"
						}
					}
					set_level_bar_item = {
						tooltip = "SPEC_LEVER_ISSUE_TT"
						blockoverride "button_texture" {
							texture = "gfx/interface/icons/spec_markets/lever_issue.dds"
						}
						blockoverride "click" {
							enabled = "[And(Country.IsLocalPlayer, And(Not(Country.MakeScope.Var('spec_issue').IsSet), And(Not(Country.MakeScope.Var('spec_issue_cool').IsSet), And(GreaterThanOrEqualTo_CFixedPoint(Country.MakeScope.Var('spec_exch_stand').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)1'), And(GreaterThanOrEqualTo_CFixedPoint(Country.MakeScope.Var(Concatenate('spec_word_', Goods.GetKey)).GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)5'), And(Not(EqualTo_CFixedPoint(Country.MakeScope.Var(Concatenate('spec_ui_r_', Goods.GetKey)).GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)2')), Not(EqualTo_CFixedPoint(Country.MakeScope.Var(Concatenate('spec_ui_e_', Goods.GetKey)).GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)2'))))))))]"
							onclick = "[GetScriptedGui('spec_sgui_issue').Execute(GuiScope.SetRoot(Country.MakeScope).AddScope('spec_good', Goods.MakeScope).End)]"
							using = increase_button_sound
						}
						blockoverride "is_selected_visibility" {
							visible = "[GreaterThan_CFixedPoint(Country.MakeScope.Var(Concatenate('spec_issue_', Goods.GetKey)).GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)0')]"
						}
						# vanilla draws the selected icon as a button on top with no click, which would swallow the click that lifts it
						blockoverride "selected_texture_size" {
							size = { 28 28 }
						}
						blockoverride "is_clickable_alpha" {
							alpha = "[TransparentIfFalse(And(Country.IsLocalPlayer, And(Not(Country.MakeScope.Var('spec_issue').IsSet), And(Not(Country.MakeScope.Var('spec_issue_cool').IsSet), And(GreaterThanOrEqualTo_CFixedPoint(Country.MakeScope.Var('spec_exch_stand').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)1'), And(GreaterThanOrEqualTo_CFixedPoint(Country.MakeScope.Var(Concatenate('spec_word_', Goods.GetKey)).GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)5'), And(Not(EqualTo_CFixedPoint(Country.MakeScope.Var(Concatenate('spec_ui_r_', Goods.GetKey)).GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)2')), Not(EqualTo_CFixedPoint(Country.MakeScope.Var(Concatenate('spec_ui_e_', Goods.GetKey)).GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)2')))))))))]"
						}
					}
				}
				expand = {}
			}
		}
