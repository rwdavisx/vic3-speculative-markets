types spec_goods_panel {
	type spec_goods_interest = widget {
		size = { 540 128 }
		parentanchor = hcenter
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			margin = { 16 14 }
			background = {
				using = entry_bg_simple
			}
			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8
				widget = {
					size = { 269 24 }
					textbox = {
						position = { 70 0 }
						size = { 195 24 }
						text = "SPEC_GP_TITLE"
						align = center|nobaseline
					}
				}
				widget = {
					size = { 269 60 }
					widget = {
						size = { 195 22 }
						position = { 70 36 }
						tooltip = "SPEC_IB_HEAT_TT"
						background = {
							texture = "gfx/interface/progressbar/progressbar_empty.dds"
							spriteType = Corneredtiled
							spriteborder = { 4 4 }
							texture_density = 2
							alpha = 0.8
							using = progressbar_texture_properties
						}
						background = {
							texture = "gfx/interface/progressbar/progressbar_frame.dds"
							spriteType = Corneredstretched
							spriteborder = { 6 6 }
							texture_density = 2
							margin = { 3 3 }
						}
						icon = {
							position = { 30 1 }
							size = { 3 20 }
							texture = "gfx/interface/progressbar/progressbar_center_divider.dds"
							texture_density = 2
						}
						icon = {
							position = { 63 1 }
							size = { 3 20 }
							texture = "gfx/interface/progressbar/progressbar_center_divider.dds"
							texture_density = 2
						}
						icon = {
							position = { 96 1 }
							size = { 3 20 }
							texture = "gfx/interface/progressbar/progressbar_center_divider.dds"
							texture_density = 2
						}
						icon = {
							position = { 129 1 }
							size = { 3 20 }
							texture = "gfx/interface/progressbar/progressbar_center_divider.dds"
							texture_density = 2
						}
						icon = {
							position = { 162 1 }
							size = { 3 20 }
							texture = "gfx/interface/progressbar/progressbar_center_divider.dds"
							texture_density = 2
						}
					}
					widget = {
						size = { 56 56 }
						position = { 4 2 }
