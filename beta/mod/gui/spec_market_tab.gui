																			}
																			custom_tooltip_textbox = {
																				visible = "[GreaterThan_CFixedPoint(Country.MakeScope.Var(Concatenate('spec_restrain_', Goods.GetKey)).GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)0')]"
																				text = "SPEC_CO_RES"
																			}
																			custom_tooltip_textbox = {
																				visible = "[GreaterThan_CFixedPoint(Country.MakeScope.Var(Concatenate('spec_glut_', Goods.GetKey)).GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)0')]"
																				text = "SPEC_CO_GLUT"
																			}
																		}
																	}
																}
															}
														}
														custom_tooltip_textbox = {
															visible = "[Company.MakeScope.Var('spec_blue_chip').IsSet]"
															text = "SPEC_CO_BC"
														}
														custom_tooltip_textbox = {
															visible = "[Company.MakeScope.Var('spec_bc_low').IsSet]"
															text = "SPEC_CO_BC_LOW"
														}
														custom_tooltip_textbox = {
															visible = "[Company.MakeScope.Var('spec_bc_months').IsSet]"
															text = "SPEC_CO_BC_CLIMB"
														}
														custom_tooltip_textbox = {
															visible = "[Company.MakeScope.Var('spec_coty').IsSet]"
															text = "SPEC_CO_COTY"
														}
														custom_tooltip_textbox = {
															visible = "[And(Company.MakeScope.Var('spec_blue_chip').IsSet, Company.MakeScope.Var('spec_bc_propped').IsSet)]"
															text = "SPEC_CO_PROPPED"
														}
														custom_tooltip_textbox = {
															visible = "[And(Company.MakeScope.Var('spec_blue_chip').IsSet, Company.MakeScope.Var('spec_bc_fragile').IsSet)]"
															text = "SPEC_CO_FRAGILE"
														}
													}
												}
											}
										}
										### the company type's art, faint and fading to the left, behind the goods; a background, as vanilla draws it
										### (companies_panel.gui:754), since only backgrounds take fittype
										widget = {
											size = { 300 100% }
											parentanchor = right
											alpha = 0.3
											background = {
												texture = "[Company.GetCompanyType.GetBackground]"
												fittype = centercrop
												modify_texture = {
													texture = "gfx/interface/masks/fade_horizontal_left.dds"
													spriteType = Corneredstretched
													spriteborder = { 0 0 }
													blend_mode = alphamultiply
												}
											}
										}
										### as vanilla's list rows: the name and prosperity take what the goods leave and elide, never running under them
										hbox = {
											size = { 100% 100% }
											margin_left = 10
											margin_right = 10
											spacing = 10
											widget = {
												size = { 44 44 }
												icon = {
													size = { 44 44 }
													texture = "[Company.GetCompanyType.GetIcon]"
												}
												icon = {
													size = { 24 24 }
													parentanchor = bottom|right
													position = { 6 6 }
													visible = "[Or(Company.MakeScope.Var('spec_blue_chip').IsSet, Company.MakeScope.Var('spec_bc_months').IsSet)]"
													alpha = "[Select_float(Company.MakeScope.Var('spec_blue_chip').IsSet, Select_float(Company.MakeScope.Var('spec_bc_low').IsSet, '(float)0.55', '(float)1.0'), '(float)0.3')]"
													texture = "gfx/interface/icons/spec_markets/blue_chip.dds"
												}
											}
											vbox = {
												spacing = 4
												textbox = {
													size = { 220 24 }
													align = left|nobaseline
													using = elide_fontsize_min
													default_format = "#header"
													text = "[Company.GetNameNoFormatting]"
												}
												vbox = {
													spacing = 3
													tooltip = "COMPANY_PROSPERITY_TOOLTIP"
													### the value and its target over the bar, as vanilla lays them out, on a line of their own so they never reach the goods
													### the value and its target on the left, the blue chip status on the right of the same line
													widget = {
														size = { 220 18 }
														textbox = {
															autoresize = yes
															align = left|nobaseline
															using = fontsize_small
															text = "COMPANY_PROSPERITY_FORMATTED"
														}
														flowcontainer = {
															parentanchor = right
															ignoreinvisible = yes
															textbox = {
																visible = "[And(Company.MakeScope.Var('spec_blue_chip').IsSet, Company.MakeScope.Var('spec_coty').IsSet)]"
																autoresize = yes
																align = right|nobaseline
																using = fontsize_small
																text = "SPEC_CO_TAG_COTY"
															}
															textbox = {
																visible = "[And(And(Company.MakeScope.Var('spec_blue_chip').IsSet, Company.MakeScope.Var('spec_bc_low').IsSet), Not(Company.MakeScope.Var('spec_coty').IsSet))]"
																autoresize = yes
																align = right|nobaseline
																using = fontsize_small
																text = "SPEC_CO_TAG_LOW"
															}
															textbox = {
																visible = "[And(And(Company.MakeScope.Var('spec_blue_chip').IsSet, Company.MakeScope.Var('spec_bc_propped').IsSet), Not(Or(Company.MakeScope.Var('spec_coty').IsSet, Company.MakeScope.Var('spec_bc_low').IsSet)))]"
																autoresize = yes
																align = right|nobaseline
																using = fontsize_small
																text = "SPEC_CO_TAG_PROPPED"
															}
															textbox = {
																visible = "[And(And(Company.MakeScope.Var('spec_blue_chip').IsSet, Company.MakeScope.Var('spec_bc_fragile').IsSet), Not(Or(Or(Company.MakeScope.Var('spec_coty').IsSet, Company.MakeScope.Var('spec_bc_low').IsSet), Company.MakeScope.Var('spec_bc_propped').IsSet)))]"
																autoresize = yes
																align = right|nobaseline
																using = fontsize_small
																text = "SPEC_CO_TAG_FRAGILE"
															}
															textbox = {
																visible = "[And(Company.MakeScope.Var('spec_blue_chip').IsSet, Not(Or(Or(Company.MakeScope.Var('spec_coty').IsSet, Company.MakeScope.Var('spec_bc_low').IsSet), Or(Company.MakeScope.Var('spec_bc_fragile').IsSet, Company.MakeScope.Var('spec_bc_propped').IsSet))))]"
																autoresize = yes
																align = right|nobaseline
																using = fontsize_small
																text = "SPEC_CO_TAG_BC"
															}
															textbox = {
																visible = "[And(Company.MakeScope.Var('spec_bc_months').IsSet, Not(Company.MakeScope.Var('spec_blue_chip').IsSet))]"
																autoresize = yes
