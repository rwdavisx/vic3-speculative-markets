	type spec_finance_navigation_guard = widget {
		name = "spec_finance_navigation_guard"
		size = { 1 1 }
		alwaystransparent = yes
		state = {
			name = spec_finance_yield_to_panel
			trigger_when = "[And3(GetVariableSystem.Exists('spec_finance'), InformationPanelBar.IsAnyPanelOpen, Not(Or(InformationPanelBar.IsPanelOpen('journal_entry'), InformationPanelBar.IsPanelOpen('journal_entry_panel'))))]"
			on_start = "[GetVariableSystem.Clear('spec_finance')]"
			on_start = "[GetVariableSystem.Clear('spec_pick_slot')]"
			duration = 0
		}
	}

	type spec_finance_window = default_block_window {
		visible = "[GetVariableSystem.Exists('spec_finance')]"
		datacontext = "[GetPlayer]"

		blockoverride "window_header_name" {
			text = "SPEC_FINANCE"
		}
		blockoverride "entire_back_button" {
			back_button_large = {
				position = { 8 30 }
				onclick = "[GetVariableSystem.Clear('spec_finance')]"
				onclick = "[GetVariableSystem.Clear('spec_pick_slot')]"
				onclick = "[InformationPanelBar.ClosePanel]"
				input_action = "back"
			}
		}
		blockoverride "header_close_button" {
			onclick = "[GetVariableSystem.Clear('spec_finance')]"
				onclick = "[GetVariableSystem.Clear('spec_pick_slot')]"
				onclick = "[InformationPanelBar.ClosePanel]"
		}
		blockoverride "fixed_top" {
			tab_buttons = {
				blockoverride "first_button" {
					text = "SPEC_FIN_TAB_EXCHANGE"
				}
				blockoverride "first_button_tooltip" {
					tooltip = "SPEC_FIN_TAB_EXCHANGE_TT"
				}
				blockoverride "first_button_click" {
					onclick = "[GetVariableSystem.Set('spec_finance_tab', 'exchange')]"
				}
				blockoverride "first_button_visibility" {
					visible = "[Or(Not(GetVariableSystem.Exists('spec_finance_tab')), GetVariableSystem.HasValue('spec_finance_tab', 'exchange'))]"
				}
				blockoverride "first_button_visibility_checked" {
					visible = "[Not(Or(Not(GetVariableSystem.Exists('spec_finance_tab')), GetVariableSystem.HasValue('spec_finance_tab', 'exchange')))]"
				}
				blockoverride "first_button_selected" {
					text = "SPEC_FIN_TAB_EXCHANGE"
				}
				blockoverride "second_button" {
					text = "SPEC_FIN_TAB_BOOMS"
				}
				blockoverride "second_button_tooltip" {
					tooltip = "SPEC_FIN_TAB_BOOMS_TT"
				}
				blockoverride "second_button_click" {
					onclick = "[GetVariableSystem.Set('spec_finance_tab', 'booms')]"
				}
				blockoverride "second_button_visibility" {
					visible = "[GetVariableSystem.HasValue('spec_finance_tab', 'booms')]"
				}
				blockoverride "second_button_visibility_checked" {
					visible = "[Not(GetVariableSystem.HasValue('spec_finance_tab', 'booms'))]"
				}
				blockoverride "second_button_selected" {
					text = "SPEC_FIN_TAB_BOOMS"
				}
				blockoverride "third_button" {
					text = "SPEC_FIN_TAB_BANKING"
				}
				blockoverride "third_button_tooltip" {
					tooltip = "SPEC_FIN_TAB_BANKING_TT"
				}
				blockoverride "third_button_click" {
					onclick = "[GetVariableSystem.Set('spec_finance_tab', 'banking')]"
				}
				blockoverride "third_button_visibility" {
					visible = "[GetVariableSystem.HasValue('spec_finance_tab', 'banking')]"
				}
				blockoverride "third_button_visibility_checked" {
					visible = "[Not(GetVariableSystem.HasValue('spec_finance_tab', 'banking'))]"
				}
				blockoverride "third_button_selected" {
					text = "SPEC_FIN_TAB_BANKING"
				}
				blockoverride "fourth_button" {
					text = "SPEC_FIN_TAB_WORLD"
				}
				blockoverride "fourth_button_tooltip" {
					tooltip = "SPEC_FIN_TAB_WORLD_TT"
				}
				blockoverride "fourth_button_click" {
					onclick = "[GetVariableSystem.Set('spec_finance_tab', 'world')]"
				}
				blockoverride "fourth_button_visibility" {
					visible = "[GetVariableSystem.HasValue('spec_finance_tab', 'world')]"
				}
				blockoverride "fourth_button_visibility_checked" {
					visible = "[Not(GetVariableSystem.HasValue('spec_finance_tab', 'world'))]"
				}
				blockoverride "fourth_button_selected" {
					text = "SPEC_FIN_TAB_WORLD"
				}
			}
		}
		blockoverride "scrollarea_content" {
			flowcontainer = {
				direction = vertical
				parentanchor = hcenter
				margin_top = 12
				margin_bottom = 24
				ignoreinvisible = yes

				widget = {
					size = { 540 90 }
					visible = "[Not(GreaterThan_CFixedPoint(Country.MakeScope.ScriptValue('spec_law_mult'), '(CFixedPoint)0'))]"
