							}
							blockoverride "text2" {
								text = "SPEC_CENTRE_STAND"
								tooltip = "SPEC_EFFECT_EXCH_TT"
		
							}
						}
						flowcontainer = {
							direction = vertical
							parentanchor = hcenter
							margin_top = 6
							margin_bottom = 12
							widget = {
								size = { 540 48 }
								parentanchor = hcenter
								tooltip = "SPEC_EXCH_CALC_TT"
								flowcontainer = {
									parentanchor = center
									spacing = 10
									icon = {
										size = { 34 34 }
										parentanchor = vcenter
										texture = "gfx/interface/icons/spec_markets/concept_exchange.dds"
									}
									textbox = {
										autoresize = yes
										parentanchor = vcenter
										align = left|nobaseline
										using = fontsize_xl
										text = "SPEC_EXCH_SCORE_LBL"
									}
									textbox = {
										autoresize = yes
										parentanchor = vcenter
										align = left|nobaseline
										using = fontsize_xxl
										text = "SPEC_EXCH_SCORE_NUM"
									}
								}
							}
							flowcontainer = {
								parentanchor = hcenter
								spacing = 10
