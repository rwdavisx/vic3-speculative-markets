											### the panic zone: below the line a panic begins, red and pulsing as the goods list's Collapse Zone
											progressbar = {
												size = { 100% 100% }
												progresstexture = "gfx/interface/progressbar/progressbar_bad.dds"
												noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
												spriteType = Corneredtiled
												spriteborder = { 4 4 }
												texture_density = 2
												alwaystransparent = yes
												min = 0
												max = 100
												value = "[FixedPointToFloat(Country.MakeScope.ScriptValue('spec_panic_at'))]"
												state = {
													name = 1
													next = 2
													alpha = 0.15
													duration = 1.4
													using = Animation_Curve_Default
													trigger_on_create = yes
												}
												state = {
													name = 2
													next = 1
													alpha = 0.45
													duration = 1.4
													using = Animation_Curve_Default
												}
											}
											### where a panic would begin now: the line rises with Leverage
											progressbar = {
												size = { 100% 100% }
												progresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
												noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
												min = 0
												max = 100
												value = "[FixedPointToFloat(Country.MakeScope.ScriptValue('spec_panic_at'))]"
												marker = {
													widget = {
														size = { 100% 100% }
														icon = {
															position = { -1 0 }
															size = { 3 100% }
															texture = "gfx/interface/graph/white.dds"
															color = { 0.8 0.2 0.15 1 }
															tooltip = "SPEC_PANIC_LINE_TT"
														}
														textbox = {
															position = { -5 0 }
															size = { 60 100% }
															widgetanchor = right
															align = right|nobaseline
															using = fontsize_small
															text = "SPEC_PANIC_TAG"
															tooltip = "SPEC_PANIC_LINE_TT"
														}
													}
												}
											}
											### where confidence would fall if every risk struck now: vanilla's white glow line (Panic's is solid red; a
											### dark edge round it read as a black stripe on the fill); its tag in a row under the bar, centred on the
											### line, so it never meets Panic's tag inside the bar whichever side of the Panic line it falls
