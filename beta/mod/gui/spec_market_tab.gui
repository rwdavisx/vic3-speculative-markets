				flowcontainer = {
					direction = vertical
					parentanchor = hcenter
					visible = "[And(GreaterThan_CFixedPoint(Country.MakeScope.ScriptValue('spec_law_mult'), '(CFixedPoint)0'), Or(Not(GetVariableSystem.Exists('spec_finance_tab')), GetVariableSystem.HasValue('spec_finance_tab', 'exchange')))]"

					flowcontainer = {
						direction = vertical
						parentanchor = hcenter
						default_header_2texts = {
